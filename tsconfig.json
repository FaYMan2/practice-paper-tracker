{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "types": ["chrome", "vitest/globals"]
  },
  "include": [
    "entrypoints/**/*",
    "utils/**/*",
    "tests/**/*",
    "wxt.config.ts",
    "vitest.config.ts",
    ".wxt/**/*"
  ]
}
